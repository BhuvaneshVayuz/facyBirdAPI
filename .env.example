# Copy to .env for local development.
CORS_ALLOW_ORIGINS=*
MAX_UPLOAD_BYTES=8388608
OUTPUT_SIZE=512

# Optional. Postgres connection string for the cutout cache -- the same Neon
# database leaderboard-api uses (this service keeps its own `face_cutouts`
# table there). Leave it unset and the cache is simply disabled: every
# request recomputes, which is exactly how this service behaved before the
# cache existed. Nothing here breaks without it.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/leaderboard

# Cached cutouts nothing has requested in this long are swept at startup.
# CACHE_TTL_DAYS=90
